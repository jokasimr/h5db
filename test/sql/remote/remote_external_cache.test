# name: test/sql/remote/remote_external_cache.test
# description: Remote HDF5 reads should use DuckDB's external file cache
# group: [remote]

require h5db

set ignore_error_messages

statement ok
PRAGMA enable_external_file_cache=true;

statement ok
SET enable_http_metadata_cache=true;

# Metadata reads from a file larger than 2 MiB should retain h5db's small
# requests, rather than fetching DuckDB's default 2 MiB cache grid.
query I
SELECT COUNT(*) > 0 FROM h5_tree('test/data/wide_few_rows.h5');
----
true

query II
SELECT COUNT(*) > 0, MAX(nr_bytes) <= 64 * 1024
FROM duckdb_external_file_cache()
WHERE path LIKE '%wide_few_rows.h5' AND loaded;
----
true	true

statement ok
CALL enable_logging('HTTP');

statement ok
CALL truncate_duckdb_logs();

query I
SELECT SUM(array_2d_chunked_small[1])
FROM (
  SELECT array_2d_chunked_small
  FROM h5_read('test/data/nd_cache_test.h5', '/array_2d_chunked_small')
  LIMIT 10
);
----
45

query I
SELECT COUNT(*) > 0 FROM duckdb_logs_parsed('HTTP') WHERE request.type='GET';
----
true

query I
SELECT COUNT(*) > 0 FROM duckdb_external_file_cache() WHERE path LIKE '%nd_cache_test.h5';
----
true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT SUM(array_2d_chunked_small[1])
FROM (
  SELECT array_2d_chunked_small
  FROM h5_read('test/data/nd_cache_test.h5', '/array_2d_chunked_small')
  LIMIT 10
);
----
45

query II
SELECT
  (SELECT COUNT(*) FROM duckdb_logs_parsed('HTTP') WHERE request.type='HEAD'),
  (SELECT COUNT(*) FROM duckdb_logs_parsed('HTTP') WHERE request.type='GET');
----
0	0

statement ok
PRAGMA enable_external_file_cache=false;

statement ok
SET enable_http_metadata_cache=true;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT SUM(array_2d_chunked_small[1])
FROM (
  SELECT array_2d_chunked_small
  FROM h5_read('test/data/nd_cache_test.h5', '/array_2d_chunked_small')
  LIMIT 10
);
----
45

statement ok
CALL truncate_duckdb_logs();

query I
SELECT SUM(array_2d_chunked_small[1])
FROM (
  SELECT array_2d_chunked_small
  FROM h5_read('test/data/nd_cache_test.h5', '/array_2d_chunked_small')
  LIMIT 10
);
----
45

query I
SELECT COUNT(*) > 0
FROM duckdb_logs_parsed('HTTP')
WHERE request.type='GET';
----
true

statement ok
PRAGMA enable_external_file_cache=true;

statement ok
SET enable_http_metadata_cache=false;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT SUM(array_2d_chunked_small[1])
FROM (
  SELECT array_2d_chunked_small
  FROM h5_read('test/data/nd_cache_test.h5', '/array_2d_chunked_small')
  LIMIT 10
);
----
45

statement ok
CALL truncate_duckdb_logs();

query I
SELECT SUM(array_2d_chunked_small[1])
FROM (
  SELECT array_2d_chunked_small
  FROM h5_read('test/data/nd_cache_test.h5', '/array_2d_chunked_small')
  LIMIT 10
);
----
45

query II
SELECT
  (SELECT COUNT(*) > 0 FROM duckdb_logs_parsed('HTTP') WHERE request.type='HEAD'),
  (SELECT COUNT(*) = 0 FROM duckdb_logs_parsed('HTTP') WHERE request.type='GET');
----
true	true

# =============================================================================
# Large raw scans should remain cacheable beyond 200 MiB
# =============================================================================

statement ok
PRAGMA enable_external_file_cache=true;

statement ok
SET enable_http_metadata_cache=true;

statement ok
SET memory_limit='1GiB';

statement ok
CALL truncate_duckdb_logs();

query I
SELECT SUM(regular) FROM h5_read('test/data/large/large_pushdown_test.h5', '/regular');
----
49999995000000

query I
SELECT COUNT(*) > 0
FROM duckdb_external_file_cache()
WHERE path LIKE '%large_pushdown_test.h5';
----
true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT SUM(regular) FROM h5_read('test/data/large/large_pushdown_test.h5', '/regular');
----
49999995000000

query II
SELECT
  (SELECT COUNT(*) = 0 FROM duckdb_logs_parsed('HTTP') WHERE request.type='HEAD'),
  (SELECT COUNT(*) = 0 FROM duckdb_logs_parsed('HTTP') WHERE request.type='GET');
----
true	true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT SUM(array_2d[1]) FROM h5_read('test/data/large/large_simple.h5', '/array_2d');
----
199999980000000

# This dataset contains 320,000,000 raw bytes. The former cutoff cached only its prefix.
query I
SELECT SUM(nr_bytes) > 256 * 1024 * 1024
FROM duckdb_external_file_cache()
WHERE path LIKE '%large_simple.h5' AND loaded;
----
true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT SUM(array_2d[1]) FROM h5_read('test/data/large/large_simple.h5', '/array_2d');
----
199999980000000

query I
SELECT COUNT(*) = 0
FROM duckdb_logs_parsed('HTTP')
WHERE request.type='GET';
----
true
